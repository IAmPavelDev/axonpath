{
    "extends": "fastify-tsconfig",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": ".",
        "target": "ES2021",
        "lib": [
            "ES2024"
        ],
        "declaration": false,
        "sourceMap": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@router/*": [
                "./src/router/*"
            ],
            "@prisma/*": [
                "./src/prisma/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "e2e-*.mts"
    ]
}
