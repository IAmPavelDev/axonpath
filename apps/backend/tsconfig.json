{
    "extends": "fastify-tsconfig",
    "compilerOptions": {
        "noEmit": true,
        "outDir": "dist",
        "rootDir": "src",
        "target": "ES2021",
        "lib": [
            "ES2024"
        ],
        "declaration": false,
        "sourceMap": true,
        "module": "preserve",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "@/*": [
                "src/*"
            ],
            "@router/*": [
                "src/router/*"
            ],
            "@prisma/*": [
                "src/prisma/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "@types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "src/**/*.test.ts"
    ]
}
