datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, pgcrypto]
}

generator client {
  provider        = "prisma-client-js"
  output          = "generated"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

// ----- Existing Authentication Models -----s
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                Int        @id @default(autoincrement())
  email             String     @unique @db.VarChar(255)
  password          String?
  firebaseUid       String?    @unique
  photoUrl          String?    @db.VarChar(1024)
  firstName         String
  lastName          String
  role              UserRole   @default(USER)
  status            UserStatus @default(PENDING_VERIFICATION)
  lastLogin         DateTime?
  emailVerified     Boolean    @default(false)
  verificationToken String?    @unique
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relationships
  skills   Skill[]
  answers  Answer[]
  events   Event[]
  Session  Session[]
  qaBlocks ClassQaBlock[]

  @@index([email, status])
  @@index([createdAt])
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  valid     Boolean  @default(true)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, valid])
  @@index([expiresAt])
}

// ----- Learning Service Models -----
enum SkillStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  GENERATING
  FAILED
}


enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  OPEN_ENDED
}

enum VectorSource {
  AI_INITIAL
  AI_NEXT
  ANSWER_DERIVED
  /** One top-level conspect block of a generated class (Phase 8). */
  CONTENT_CHUNK
  /** One answered learner Q&A block, mined into memory (Phase 8). */
  QA_DERIVED
}

enum EventType {
  SKILL_CREATED
  CLASS_GENERATED
  ANSWER_SUBMITTED
  CONTEXT_SELECTED
  ERROR_OCCURRED
  QA_ANSWERED
  VECTOR_UPSERTED
  CLASS_OPTIONS_GENERATED
}

model Skill {
  id        Int             @id @default(autoincrement())
  user      User            @relation(fields: [userId], references: [id])
  userId    Int
  topic     String          @db.VarChar(255)
  /** The learner's original freeform brief; title/description are generated from it. */
  prompt    String          @default("") @db.Text
  description String      @default("") @db.Text
  status    SkillStatus     @default(DRAFT)
  recommendationsStatus RecommendationsStatus?
  recommendationsAttempts Int        @default(0)
  requestId Int?            @unique
  classes   Class[]
  questions Question[]
  answers   Answer[]
  progress  SkillProgress[]
  events    Event[]
  vectors   Vector[]
  recommendations  SkillRecommendation[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
  @@index([requestId])
}

model Class {
  id        Int        @id @default(autoincrement())
  skill     Skill      @relation(fields: [skillId], references: [id])
  skillId   Int
  index     Int
  title     String     @db.VarChar(255)
  contentMd String     @db.Text
  aiModel   String?
  vectors   Vector[]
  questions Question[]
  qaBlocks  ClassQaBlock[]
  clipStatus ClassClipStatus @default(SKIPPED)
  clipAttempts Int           @default(0)
  clipLeaseAt DateTime?
  videoClips ClassVideoClip[]
  createdAt DateTime   @default(now())

  @@unique([skillId, index])
  @@index([skillId, index])
}

enum ClassClipStatus {
  PENDING
  READY
  SKIPPED
}

enum RecommendationsStatus {
  PENDING
  READY
  FAILED
}

enum VideoAssetStatus {
  DISCOVERED
  INDEXED
  NO_TRANSCRIPT
  FAILED
}

/// Cache of one YouTube video's fetched metadata + timestamped transcript.
/// Keyed by videoId — replayed jobs and later lessons reuse it for free.
model VideoAsset {
  id              Int             @id @default(autoincrement())
  videoId         String          @unique
  title           String          @db.VarChar(255)
  channel         String          @default("")
  durationSeconds Int?
  transcript      Json?
  transcriptSource String?
  status          VideoAssetStatus @default(DISCOVERED)
  failureCount    Int             @default(0)
  lastError       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

/// Top-10 whole-video picks per skill for the Recommendations tab.
model SkillRecommendation {
  id              Int      @id @default(autoincrement())
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId         Int
  videoId         String
  title           String   @db.VarChar(255)
  channel         String   @default("")
  durationSeconds Int?
  rank            Int
  score           Float?
  createdAt       DateTime @default(now())

  @@unique([skillId, videoId])
  @@index([skillId, rank])
}

/// One lesson (class) video segment, anchored after a conspect block.
model ClassVideoClip {
  id                Int      @id @default(autoincrement())
  class             Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId           Int
  anchorParagraph   Int
  videoId           String
  title             String   @db.VarChar(255)
  channel           String   @default("")
  startSeconds      Float
  endSeconds        Float
  transcriptExcerpt String?
  concept           String   @default("")
  createdAt         DateTime @default(now())

  @@index([classId, anchorParagraph])
}

model Question {
  id        Int          @id @default(autoincrement())
  skill     Skill        @relation(fields: [skillId], references: [id])
  skillId   Int
  class     Class?       @relation(fields: [classId], references: [id])
  classId   Int?
  type      QuestionType
  text      String       @db.Text
  choices   Json?
  answerKey Json?
  aiModel   String?
  answers   Answer[]
  createdAt DateTime     @default(now())

  @@index([skillId, classId])
  @@index([type])
}

model Answer {
  id          Int      @id @default(autoincrement())
  question    Question @relation(fields: [questionId], references: [id])
  questionId  Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  content     Json
  score       Float?
  isCorrect   Boolean?
  timeSpentMs Int
  device      String?  @db.VarChar(255)
  vectors     Vector[]
  createdAt   DateTime @default(now())
  Skill       Skill?   @relation(fields: [skillId], references: [id])
  skillId     Int?

  @@index([questionId])
  @@index([userId])
  @@index([isCorrect])
}

model SkillProgress {
  id        Int      @id @default(autoincrement())
  skill     Skill    @relation(fields: [skillId], references: [id])
  skillId   Int
  snapshot  Json
  updatedAt DateTime @updatedAt

  @@index([skillId])
}

model Event {
  id        Int       @id @default(autoincrement())
  skill     Skill     @relation(fields: [skillId], references: [id])
  skillId   Int
  type      EventType
  payload   Json
  createdAt DateTime  @default(now())
  User      User?     @relation(fields: [userId], references: [id])
  userId    Int?

  @@index([skillId, type])
  @@index([createdAt])
}

model Vector {
  id          Int                         @id @default(autoincrement())
  skill       Skill                       @relation(fields: [skillId], references: [id])
  skillId     Int
  source      VectorSource
  textSnippet String                      @db.Text
  classIndex  Int?
  tokenCount  Int?
  createdAt   DateTime                    @default(now())
  Class       Class?                      @relation(fields: [classId], references: [id])
  classId     Int?
  Answer      Answer?                     @relation(fields: [answerId], references: [id])
  answerId    Int?
  ClassQaBlock ClassQaBlock?              @relation(fields: [qaBlockId], references: [id])
  qaBlockId   Int?

  @@index([skillId])
  @@index([classIndex])
  @@index([source])
}

enum ClassQaStatus {
  PENDING
  ANSWERED
  FAILED
}

/**
 * Learner question anchored inside a class conspect. Blocks are flat (no
 * nesting): a follow-up is another block anchored after the previous answer.
 * anchorParagraph indexes the class's top-level markdown blocks in document
 * order — stable because contentMd is immutable once generated (regeneration
 * creates a new class). Blocks sharing an anchor keep ask order via
 * (createdAt, id). The answer fills in asynchronously (PENDING until then);
 * FAILED is terminal — the client re-asks to retry.
 */
model ClassQaBlock {
  id              Int           @id @default(autoincrement())
  class           Class         @relation(fields: [classId], references: [id])
  classId         Int
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  anchorParagraph Int
  /** Verbatim learner selection at ask time; null when anchored by tap only. */
  anchorText      String?       @db.Text
  question        String        @db.Text
  answer          String?       @db.Text
  status          ClassQaStatus @default(PENDING)
  requeueCount    Int           @default(0)
  aiModel         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vectors         Vector[]

  @@index([classId, anchorParagraph])
  @@index([userId])
}

// ----- Background Processing Models -----

enum NextClassJobStatus {
  PENDING
  PROCESSING
}

/**
 * Durable marker that a skill is due for its next lesson. submit-quiz writes
 * it; the minute sweeper or the instant in-process job claims it. Deliberately
 * FK-free: infrastructure bookkeeping, not domain data (skills are never
 * deleted), and the marker must outlive nothing but a generation attempt.
 */
model NextClassJob {
  id        Int                @id @default(autoincrement())
  skillId   Int                @unique
  userId    Int
  attempts  Int                @default(0)
  claimedAt DateTime?
  status    NextClassJobStatus @default(PENDING)
  createdAt DateTime           @default(now())
}

/**
 * One row per AI provider call attempt, written fire-and-forget at the point
 * the outcome is known (never gates the learner flow). The grain that makes
 * prompt/parser changes measurable: success rate, attempts-to-success, parse
 * failures, latency and token spend — all sliceable by promptVersion /
 * parserVersion. Audit events (SKILL_CREATED, QA_ANSWERED, ...) stay the
 * raw-output record; this is the aggregated metrics record.
 */
model AiAttempt {
  id               Int      @id @default(autoincrement())
  userId           Int?
  /**
   * init_skill | skill_metadata | next_class | grade_open | qa_answer
   */
  operation        String
  /**
   * 1-based attempt within one operation invocation. Cross-invocation job
   * retries (e.g. next-class's 3 sweeper attempts) surface as separate
   * invocations — each row's outcome still tells the whole story.
   */
  attempt          Int
  /**
   * ok | parse_failed | empty | length_capped | transport_error |
   * balance_error
   */
  outcome          String
  model            String
  latencyMs        Int
  promptTokens     Int?
  completionTokens Int?
  rawChars         Int?
  promptVersion    String
  parserVersion    String
  errorKind        String?
  createdAt        DateTime @default(now())

  @@index([operation, createdAt])
  @@index([promptVersion, outcome])
}
