{
  "name": "@axon/backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema ./src/prisma/schema.prisma",
    "prisma:pull": "prisma db pull --schema ./src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate --schema ./src/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ./src/prisma/schema.prisma --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ./src/prisma/schema.prisma",
    "dev-db": "docker-compose -f dev-db/docker-compose.yaml up -d",
    "dev-db:stop": "docker-compose -f dev-db/docker-compose.yaml down",
    "start": "docker-compose -f docker-compose-prod.yaml up -d",
    "dev": "docker-compose -f docker-compose-dev.yaml up -d",
    "dev:watch": "nodemon --watch src --ext ts,tsx,js,json --exec 'tsx --require tsconfig-paths/register src/main.ts'",
    "build": "tsc",
    "serve": "node dist/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fastify-tsconfig": "^3.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@axon/api-contract": "workspace:*",
    "@fastify/env": "^5.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@orpc/client": "^1.8.6",
    "@orpc/openapi": "^1.8.6",
    "@orpc/server": "^1.8.6",
    "@orpc/zod": "^1.8.6",
    "@prisma/client": "6.15.0",
    "@qdrant/js-client-rest": "1.19.0",
    "fastify": "^5.5.0",
    "module-alias": "^2.2.3",
    "openai": "^7.15.0",
    "prisma": "^6.15.0",
    "zod": "^4.1.5"
  }
}
