{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Metro resolves package exports with the "react-native" condition
    // (e.g. firebase/auth's RN persistence types); keep tsc in sync.
    "customConditions": ["react-native"],
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@atomics/*": ["./atomics/*"],
      "@hooks/*": ["./hooks/*"],
      "@axon/api-contract": ["../../packages/api-contract/src"],
      "@axon/api-contract/*": ["../../packages/api-contract/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"]
}
