# Firebase web-app config (Project settings → Your apps → Web app).
# Email/password auth works in Expo Go once these are set.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in only (needs a dev build — see FIREBASE_SETUP.md).
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=
