{
  "name": "axon",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "backend:dev": "docker-compose -f docker-compose-dev.yaml up -d",
    "backend:build": "docker-compose -f docker-compose-dev.yaml build",
    "backend:rebuild": "docker-compose -f docker-compose-dev.yaml build --no-cache",
    "backend:start": "docker compose --env-file .env.aws -f docker-compose-prod.yaml up -d",
    "backend:image": "docker build --target production -t axon-backend:local .",
    "backend:image:lambda": "docker build --target lambda -t axon-backend:lambda .",
    "backend:dev:rebuild": "docker-compose -f docker-compose-dev.yaml up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "lightningcss": "1.27.0"
  }
}
