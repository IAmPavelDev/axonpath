# Axon — TLS terminator for the static-IP endpoint. Serves the self-signed
# certificate generated by deploy/generate-certs.sh (SAN = the Elastic IP);
# the matching root CA is bundled into the Android app. No ACME, no domain.
:443 {
	tls /certs/server.crt /certs/server.key
	reverse_proxy backend:3001
}
