# Axon — AWS beta environment (cp .env.aws.example .env.aws, then fill every value)
# Secrets stay on the server only: this file is git-ignored and excluded from
# docker build context (.dockerignore). chmod 600 after filling.

# --- Compose interpolation (read by docker-compose-prod.yaml itself) ---
# Cloudflare Zero Trust → Networks → Tunnels → axon-beta → copy the token.
CF_TUNNEL_TOKEN=
POSTGRES_USER=axon
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=axon
RABBITMQ_USER=axon
# openssl rand -base64 24
RABBITMQ_PASSWORD=

# --- Backend container (injected via env_file: .env.aws) ---
NODE_ENV=production
APP_PORT=3001
APP_HOST=0.0.0.0
# Same credentials as POSTGRES_* above; host is the compose service name `db`.
DATABASE_URL=postgresql://axon:PASTE_POSTGRES_PASSWORD@db:5432/axon
QDRANT_URL=http://qdrant:6333
# Firebase console → Project settings → General → Web app → project_id.
# Must be the same Firebase project the mobile app is configured against.
FIREBASE_PROJECT_ID=
# z.ai key (chat model) and Google AI Studio key (embeddings).
ZAI_API_KEY=
GEMINI_API_KEY=
