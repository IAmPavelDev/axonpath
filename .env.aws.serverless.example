# Axon — serverless (Lambda) environment.
# cp .env.aws.serverless.example .env.aws.serverless and fill every value.
# chmod 600 after filling; never commit the filled file.
#
# These values are loaded into the Lambda functions' environment
# (api + worker). NODE_ENV=production and LAMBDA_ROLE are set per function
# in the provisioning script. DATABASE_URL is quoted: the provisioning
# script sources this file with bash, and unquoted "&" would truncate it.

# --- RDS Postgres (instance axon-db, eu-central-1) ---
# Direct endpoint (no pooler); sslmode=require — RDS enforces TLS.
DATABASE_URL="postgresql://axon_admin:PASTE_PASSWORD@axon-db.xxxx.eu-central-1.rds.amazonaws.com:5432/axon?sslmode=require"
RDS_MASTER_PASSWORD=

# --- Qdrant Cloud free cluster ---
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- Firebase (same project the mobile app is configured against) ---
FIREBASE_PROJECT_ID=

# --- AI providers: z.ai (chat) and Google AI Studio (embeddings) ---
ZAI_API_KEY=
# Optional log verbosity for the functions: debug | info | warn | error
# (default info). Set only when a deploy needs louder logs.
#LOG_LEVEL=
GEMINI_API_KEY=
