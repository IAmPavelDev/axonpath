{
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "rootDir": "src",
    "target": "ES2021",
    "lib": [
        "ES2021"
    ],
    "declaration": false,
    "sourceMap": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@schema/*": ["./src/schema/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": ["src"]
}